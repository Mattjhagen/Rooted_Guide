# Plumb Line Environment Configuration
#
# Copy this file to .env.local for local development

# Guide Service API (optional)
# If not set in development, uses local development mock
# If not set in production, guide service shows as unavailable
# EXPO_PUBLIC_GUIDE_API_URL=https://api.plumbline.app/v1

# ⚠️ SECURITY WARNING ⚠️
# NEVER set AI provider API keys, secrets, or credentials here.
# All provider credentials belong exclusively on the server.
#
# DO NOT ADD:
# - EXPO_PUBLIC_OPENAI_API_KEY
# - EXPO_PUBLIC_ANTHROPIC_API_KEY
# - EXPO_PUBLIC_GEMINI_API_KEY
# - Any service-role keys
# - Any long-lived tokens
#
# The mobile app should only know about the application API endpoint,
# never about AI providers or their credentials.
